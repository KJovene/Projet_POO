upstream locatic_backend {
    server {{ nginx_upstream }};
}

server {
    listen 80 default_server;
    server_name _;

    # Reverse-proxy vers l'application Locatic (Kestrel).
    location / {
        proxy_pass http://locatic_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Sonde de santé du proxy (relaie /health de l'application).
    location = /proxy-health {
        default_type application/json;
        return 200 '{"proxy":"ok","app":"{{ app_name }}","environment":"{{ app_environment }}","upstream":"{{ nginx_upstream }}"}';
    }
}
